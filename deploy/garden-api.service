[Unit]
Description=Garden Flask API (gunicorn)
After=network.target

[Service]
Type=simple
User=<username>
WorkingDirectory=/home/<username>/Automated_Watering_System/indoor
Environment=WEATHERAPI_KEY=<your_key_here>
Environment=OPENWEATHERMAP_KEY=<your_key_here>
Environment=TOMORROWIO_KEY=<your_key_here>
ExecStart=/home/<username>/.local/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 flask_api:app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
