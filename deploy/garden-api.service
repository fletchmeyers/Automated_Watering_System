[Unit]
Description=Garden Flask API (gunicorn)
After=network.target

[Service]
Type=simple
User=<username>
WorkingDirectory=/home/<username>/Automated_Watering_System/raspberrypi
# Weather API keys (WEATHERAPI_KEY, OPENWEATHERMAP_KEY, TOMORROWIO_KEY) live
# outside git in this root-only file; deploy/install.sh creates it.
EnvironmentFile=/etc/garden-api.env
ExecStart=/home/<username>/.local/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 flask_api:app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
